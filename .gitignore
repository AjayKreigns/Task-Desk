# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Real credentials — Netlify gets these from its own environment variable
# settings, not from a committed file. .env.localtest (the local-only-mode
# test override used during development) is covered by *.local above.
.env
.env.*
!.env.example

# Backend/ops scripts, kept local-only (confirmed with the user — this repo
# is the frontend app only). None of these ship in the built app or are ever
# imported by src/ — they're pasted into Supabase's SQL Editor or WordPress
# by hand, or run standalone with `node`.
supabase_*.sql
wordpress-*.php
docs/
scripts/
test-supabase.mjs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea

# Local tooling state — machine-specific, not meant to be shared
.claude
.netlify
.archify
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
